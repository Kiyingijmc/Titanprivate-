# --- Secrets / environment ---
.env

# --- Python ---
__pycache__/
*.py[cod]
# no trailing slash: worktrees carry .venv as a symlink, which `.venv/` misses
.venv
venv/

# --- Runtime state (databases) ---
data/db/*.db
data/db/*.db-shm
data/db/*.db-wal
# Prospective shadow observations and cohort-local runtime files.
data/shadow/

# --- Generated history exports (reproducible via scripts/export_history.py) ---
data/history/

# --- Broker instrument spec cache (reproducible via scripts/cache_specs.py).
# Broker- and account-specific, so it must never be a test input: anything that
# needs specs passes an explicit fixture path (see tests/unit/test_research_run.py).
data/specs.json

# --- Logs & crash dumps ---
data/logs/*.log
boot_crash.log
data/journal/
# Transient verification/timing logs dropped at the repo root by a session
# (.S023_full_suite.log, _probe_timing.log ...). They are build output, not
# source, and have twice been committed by accident -- keep them untracked.
# (boot_crash.log above predates this and stays tracked; gitignore does not
# retroactively untrack.)
/*.log

# --- Research lake (Parquet; frozen/ is kept in git) ---
data/lake/**
!data/lake/frozen/
!data/lake/frozen/**

# --- Research run-cards (reproducible via scripts/research_run.py) ---
data/results/**

data/news/

# --- Control GUI overrides (machine state, not source) ---
config/overrides.yaml
graphify-out/
.mig/state/
.mig/worktrees/
.gstack/
.superpowers/

# Local management database and reproducible diagnostic runs.
data/*.db
data/*.db-shm
data/*.db-wal
data/research/

# Local copies of prior frontend builds.
/dist.bak-*/
