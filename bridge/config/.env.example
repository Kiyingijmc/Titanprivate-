BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8766
BRIDGE_AUTH_TOKEN=CHANGE_ME_generate_a_long_random_token
# MT5 connection — leave these COMMENTED OUT to attach to the already-logged-in MT5
# terminal (recommended). Do NOT leave them as empty assignments (e.g. MT5_LOGIN=):
# an empty string fails to parse into the int|None login field at startup.
# MT5_LOGIN=12345678
# MT5_PASSWORD=your_password
# MT5_SERVER=FBS-Demo
# MT5_PATH=C:\\Path\\To\\terminal64.exe
LOG_LEVEL=INFO
LOG_FILE=logs/bridge.log
