# ==============================================================================
# TITAN ICT BOT v14.3 - ENVIRONMENT TEMPLATE
# Copy this file to ".env" and fill in real values. Never commit ".env".
# ==============================================================================

# ------------------------------------------------------------------------------
# TELEGRAM TELEMETRY + REMOTE CONTROL
# Powers trade alerts and admin commands (/status, /pause, /panic, /closeall).
#
# 1. In Telegram, open "@BotFather", send "/newbot", copy the HTTP API token.
# 2. Open "@userinfobot", send "/start", copy your numeric ID.
# ------------------------------------------------------------------------------
TELEGRAM_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-numeric-chat-id

# ------------------------------------------------------------------------------
# MT5 CREDENTIALS (optional; "x" disables)
# ------------------------------------------------------------------------------
MT5_LOGIN=x
MT5_PASS=x

# ------------------------------------------------------------------------------
# SYSTEM FLAGS
# ENVIRONMENT: "PROD" (logs to file+db) or "DEV" (verbose console)
# ------------------------------------------------------------------------------
TITAN_ENV=PROD

# Titan HTTP bridge (Linux client) — Phase 1
TITAN_BRIDGE_TOKEN=match_bridge_config_env_BRIDGE_AUTH_TOKEN
# TITAN_BRIDGE_URL=http://127.0.0.1:8766   # optional override; auto-resolved if unset
